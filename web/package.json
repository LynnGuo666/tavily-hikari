{
  "name": "tavily-hikari-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "bun --bun ./node_modules/.bin/vite",
    "demo": "VITE_DEMO_MODE=true bun --bun ./node_modules/.bin/vite --host 127.0.0.1 --port 55174",
    "build": "bun --bun ./node_modules/.bin/tsc -b && bun --bun ./node_modules/.bin/vite build && bun ./scripts/write-version.mjs && python3 ./scripts/generate_pwa_assets.py",
    "storybook": "bun --bun ./node_modules/.bin/storybook dev --host 127.0.0.1 --port 56006 --disable-telemetry",
    "storybook:ci": "bun --bun ./node_modules/.bin/storybook dev --ci --no-open --host 127.0.0.1 --port 56006 --disable-telemetry",
    "build-storybook": "bun --bun ./node_modules/.bin/storybook build --disable-telemetry",
    "preview": "bun --bun ./node_modules/.bin/vite preview",
    "test": "bun test",
    "test:source-budgets": "bun test tests/sourceLineBudgets.test.ts",
    "test:e2e:pwa-offline": "bun ../tests/e2e/pwa_offline_browser_e2e.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@iconify/react": "^4.1.1",
    "@milkdown/crepe": "^7.21.1",
    "@milkdown/kit": "^7.21.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.511.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.8.9",
    "@iconify-json/circle-flags": "^1.2.10",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.73",
    "@storybook/addon-docs": "10.2.10",
    "@storybook/react-vite": "10.2.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^20.14.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "agentation": "^3.1.2",
    "storybook": "10.2.10",
    "tailwindcss": "4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
